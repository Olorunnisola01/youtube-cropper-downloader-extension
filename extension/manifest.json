{
  "manifest_version": 3,
  "name": "YouTube Cropper",
  "version": "1.0.0",
  "description": "Set a start/end range on the current YouTube video and send it to your local cropper to download the trimmed clip at the highest available quality.",
  "permissions": ["activeTab", "scripting", "sidePanel", "tabs", "downloads"],
  "host_permissions": ["*://*.youtube.com/*", "http://127.0.0.1:8783/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
